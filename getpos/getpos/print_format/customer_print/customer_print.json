 "css": " /*General table styling */\n.custom-receipt-table, \n.custom-receipt-table tr, \n.custom-receipt-table td, \n.custom-receipt-table th {\n    border: none !important;\n    padding: 2px 0px !important;\n    line-height: 1 !important;\n}\n\n /*Add a bottom border under the header row */\n.custom-receipt-table thead tr {\n    border-bottom: 1px solid grey !important;\n}\n /*Adjust spacing for specific elements */\n.custom-receipt-table td {\n    vertical-align: middle !important;\n}\n\n/* Add a line after the last row of the table */\n.custom-receipt-table1 tbody tr:last-child {\n    border-bottom: 1px solid grey !important;\n}\n/* Ensure minimal space above and below the table */\n.custom-receipt-table {\n    margin-top: 0 !important;\n    padding-top: 0 !important;\n}\n\n /*Specific styling for the Cash Received and Balance section */\n.custom-payment-details td {\n    color: #cccccc !important; /* Light gray */\n    font-size: 10px !important; /* Reduce size */\n    font-style: italic !important; /* Make it italic */\n    font-weight: 200 !important; /* Lighter text */\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<script>\n    document.addEventListener(\"DOMContentLoaded\", function() {\n    // Retrieve values from localStorage\n    var storedOrderType = localStorage.getItem(\"orderType\") || \"{}\";  // Default to empty object\n    var storedCashTransaction = localStorage.getItem(\"cashTransaction\") || \"{}\";  // Default to empty object\n\n    // Parse the stored JSON data\n    var orderTypeData = JSON.parse(storedOrderType);  // Convert string to object for orderType\n    var cashTransactionData = JSON.parse(storedCashTransaction);  // Convert string to object for cashTransaction\n\n    // Access specific keys safely\n    var typeofOrder = orderTypeData.orderType || \"No Data\";  // Fallback to \"No Data\" if not found\n    var cashReceived = cashTransactionData.cashReceived || \"No Data\";\n    var balance = cashTransactionData.balance || \"No Data\";\n\n    console.log(\"Order Type:\", typeofOrder);\n    console.log(\"Cash Received:\", cashReceived);\n    console.log(\"Balance:\", balance);\n\n    // Inject values into placeholders\n    document.getElementById(\"typeofOrder\").textContent = typeofOrder; \n    document.getElementById(\"cashReceived\").textContent = cashReceived;\n    document.getElementById(\"balance\").textContent = balance;\n});\n</script>\n<style>\n\t.print-format table, .print-format tr, \n\t.print-format td, .print-format div, .print-format p {\n\t\tline-height: 90%;\n\t\tvertical-align: middle;\n\t}\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 4in;\n\t\t\t/*padding: 0.25in;*/\n\t\t\t/*min-height: 8in;*/\n\t\t\tmin-height: auto;\n\t\t\tpadding: 0.10in;\n\n\t\t}\n\t}\n</style>\n{% set date =  doc.get_formatted(\"transaction_date\") %}\n{% set time =  doc.get_formatted(\"transaction_time\")%}\n{% if letter_head %}\n    {{ letter_head }}\n{% endif %}\n\n<p class=\"text-center\" style=\"margin-bottom: 1rem\">\n\t<b>{{  _(\"TAX INVOICE\") }}</b><br>\n</p>\n<!--<p style=\"padding-left: 25px;\">-->\n<!--\t<b>{{ _(\"Bill#\") }}</b> {{ doc.name }} | &nbsp;&nbsp;&nbsp; {{ _(\"Token#\") }} &nbsp;&nbsp; {{ doc.custom_token or 0 }}<br>-->\n<!--</p>-->\n<p style=\"display: flex; justify-content: space-between;\">\n    <span><b>{{ _(\"Bill#\") }}</b> {{ doc.name }}</span>\n    <span style=\"margin-left: 20px;\"><b>{{ _(\"Token#\") }}</b> {{ doc.custom_token or 0 }}</span>\n</p>\n<div style=\"display: flex; justify-content: space-between;\">\n    <p>\n\t    <b>{{ date }}<br>\n\n    </p>\n    <p style=\"\">\n    \t<b>{{ time }}<br>\n    </p>\n</div>\n<table class=\"table table-condensed custom-receipt-table custom-receipt-table1\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th width=\"70%\">{{ _(\"Description\") }}</th>\n\t\t\t<th width=\"15%\" class=\"text-right\">{{ _(\"Qty\") }}</th>\n\t\t\t<th width=\"15%\" class=\"text-right\">{{ _(\"Amt Incl.Tax\") }}</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t{%- for item in doc.items -%}\n\t\t<tr>\n\t\t\t<td>\n\t\t\t\t{{ item.item_name }}\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">{{ item.qty }}</td>\n\t\t\t<!--<td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>-->\n\t\t\t<td class=\"text-right\">{{ \"%.2f\"|format(item.amount * 1.05) }}</td>\n\t\t</tr>\n\t\t{%- endfor -%}\n\t</tbody>\n</table>\n<table class=\"table table-condensed no-border custom-receipt-table\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<!--{% if doc.flags.show_inclusive_tax_in_print %}-->\n\t\t\t<!--\t<td class=\"text-right\" style=\"width: 70%\">-->\n\t\t\t<!--\t\t{{ _(\"Total Excl. Tax\") }}-->\n\t\t\t<!--\t</td>-->\n\t\t\t<!--\t<td class=\"text-right\">-->\n\t\t\t<!--\t\t{{ doc.get_formatted(\"net_total\", doc) }}-->\n\t\t\t<!--\t</td>-->\n\t\t\t<!--{% else %}-->\n\t\t\t\t<td class=\"text-left\" style=\"width: 70%\">\n\t\t\t\t\t{{ _(\"Total Before VAT\") }}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ doc.get_formatted(\"total\", doc) }}\n\t\t\t\t</td>\n\t\t\t<!--{% endif %}-->\n\t\t</tr>\n\t\t        <td class=\"text-left\" style=\"width: 70%\">\n\t\t\t\t\t{{ _(\"VAT incl.\") }}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ doc.get_formatted(\"total_taxes_and_charges\") }}\n\t\t\t\t</td>\n\n\t\t{%- if doc.discount_amount -%}\n\t\t<tr>\n\t\t\t<td class=\"text-left\" style=\"width: 75%\">\n\t\t\t\t{{ _(\"Discount\") }}\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"discount_amount\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- endif -%}\n\t\t<tr>\n\t\t\t<td class=\"text-left\" style=\"width: 75%\">\n\t\t\t\t<b>{{ _(\"Grand Total\") }}</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"grand_total\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- if doc.rounded_total -%}\n\t\t<tr>\n\t\t\t<td class=\"text-left\" style=\"width: 75%\">\n\t\t\t\t<b>{{ _(\"Rounded Total\") }}</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-right\">\n\t\t\t\t{{ doc.get_formatted(\"rounded_total\") }}\n\t\t\t</td>\n\t\t</tr>\n\t\t{%- endif -%}\n\t\t<!-- Cash Received and Balance -->\n\t\t<!-- Line down -->\n\t\t<!--<tr>-->\n  <!--          <td colspan=\"2\"></br></td> -->\n  <!--      </tr>-->\n\t\t<tr class=\"custom-payment-details\">\n\t\t\t<td class=\"text-left\"style=\"width: 75%; color: grey; opacity: 0.6;\">\n\t\t\t\t<b>{{ _(\"Cash Received\") }}</b>\n\t\t\t</td>\n\t\t    <td class=\"text-right\"style=\"width: 75%; color: grey; opacity: 0.6;\">\n                <span id=\"cashReceived\">{{ doc.get_formatted(\"cashReceived\") }}</span>\u062f.\u0625\n            </td>\n\t\t</tr>\n\t\t<tr class=\"custom-payment-details\">\n\t\t\t<td class=\"text-left\" style=\"width: 75%; color: grey; opacity: 0.6;\">\n\t\t\t\t<b>{{ _(\"Balance\") }}</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-right\" style=\"width: 75%; color: grey; opacity: 0.6;\">\n\t\t\t\t<!--{{ doc.get_formatted(\"balance\") }}-->\n\t\t\t\t<span id=\"balance\">{{ doc.get_formatted(\"balance\") }}</span>\u062f.\u0625\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"text-center\">\n\t\t\t\t<b style=\"padding-left: 100px \">***{{ doc.get_formatted(\"custom_payment_status\") }}***</b>\n\t\t\t</td>\n\t\t\t<td class=\"text-center\">\n\t\t\t\t{{ doc.get_formatted(\"paid_amount\") }}\n\t\t\t</td>\n\t\t</tr>\n\t    <tr>\n\t\t    <td class=\"text-center\">\n\t\t\t<span style=\"padding-left: 100px \"id=\"typeofOrder\">{{ doc.get_formatted(\"typeofOrder\") }}</span>\n\t\t\t</td>\n\t\t</tr>\n\t\n\t\t{%- if doc.change_amount -%}\n\t\t\t<tr>\n\t\t\t\t<td class=\"text-right\" style=\"width: 75%\">\n\t\t\t\t\t<b>{{ _(\"Change Amount\") }}</b>\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t\t{{ doc.get_formatted(\"change_amount\") }}\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t{%- endif -%}\n\t\t\t<tr>\n\t\t\t    <td class=\"text-left\" style=\"width: 75%;\">\n\t\t\t\t\t<p>\n\t\t\t\t\t    Waiter Name: <br/> Cashier Name: {{ frappe.db.get_value(\"User\", frappe.session.user, \"full_name\") or \"Unknown\" }}\n\t\t\t\t\t</p>\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">\n\t\t\t\t</td>\n\t\t\t</tr>\n\t</tbody>\n</table>\n<p>{{ doc.terms or \"\" }}</p>\n<p class=\"text-center\">{{ _(\"***Thank you, please visit again.***\") }}</p>",
